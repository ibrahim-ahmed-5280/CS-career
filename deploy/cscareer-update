#!/usr/bin/env bash
# Pull the newest code from GitHub, build it and restart the app. Runs every 30s from a systemd timer.
set -euo pipefail
REPO=https://github.com/ibrahim-ahmed-5280/CS-career.git
SRC=/opt/cscareer

[ -d "$SRC/.git" ] || git clone --quiet --depth 1 "$REPO" "$SRC"
cd "$SRC"
git fetch --quiet --depth 1 origin master
NEW=$(git rev-parse FETCH_HEAD)
OLD=$(cat /var/lib/cscareer.rev 2>/dev/null || true)
[ "$NEW" = "$OLD" ] && exit 0

git reset --quiet --hard FETCH_HEAD
npm --prefix server ci --omit=dev --no-audit --no-fund --silent
npm --prefix client ci --no-audit --no-fund --silent
npm --prefix client run build --silent
systemctl restart cscareer-api

echo "$NEW" > /var/lib/cscareer.rev
echo "$(date -Is) deployed ${NEW:0:7}" >> /var/log/cscareer-deploy.log
