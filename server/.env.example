# Copy to .env (development) or /etc/cscareer.env (server) and fill in.
NODE_ENV=production
PORT=4000
# MongoDB Atlas or your own MongoDB. Leave empty in development to use the embedded one.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/cscareer
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
